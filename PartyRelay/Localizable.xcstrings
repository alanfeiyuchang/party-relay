    },
    "settings.rules_body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each round, spin once and both teams play the same game. The higher score wins the round point (a tie gives one point to each). Most points after all rounds wins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轮转一次盘，两队各玩一遍同一个游戏比小分；小分高者 +1 大分（平则各 +1）。全部轮次后大分多者胜。"
          }
        }
      }
    },
    "settings.rules_body_small": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each round, spin once and both teams play the same game. Every correct guess adds to that team's running total — no big points. After all rounds, the highest total wins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轮转一次盘，两队各玩一遍同一个游戏；猜对的小分直接累进总分，不设大分。全部轮次后累计小分多者胜。"
          }
        }
