      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: no big points at all — every correct guess adds to a running total, and the team with the most points after all rounds wins. Off: each round's small-score winner takes 1 big point (the classic rules)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后：完全不设大分，每次猜对都累进总分，全部轮次结束后累计小分最高的队获胜。关闭则沿用原规则：每轮小分赢家 +1 大分。"
